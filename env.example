# Configuración de IA para resolver CAPTCHA numérico
# Elige UNA de las siguientes opciones:

# Opción 1: Google Gemini (Recomendado - tiene capa gratuita)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Opción 2: OpenAI GPT-4 Vision
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_aqui

# Configuración del navegador
# headless=true para ejecutar sin interfaz visible (más rápido)
# headless=false para ver el navegador (útil para depuración)
HEADLESS_MODE=false

# Tiempo de espera máximo en segundos
TIMEOUT=30
